{
  "name": "rugby-manager",
  "version": "0.62.0",
  "description": "Le FM du rugby français — focus modélisation match + vie de vestiaire",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:simulate": "vitest run tests/simulation",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "play": "tsx tools/play-match.ts",
    "play:stats": "tsx tools/seed-stats.ts",
    "calibrate": "tsx tools/calibrate.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
