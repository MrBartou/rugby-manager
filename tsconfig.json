{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    /*
     * Vite assure seule la transpilation : `tsc` ne sert ici qu'à vérifier les types.
     * Sans noEmit, `npm run build` déposait un .js compilé à côté de chaque source,
     * et la résolution de `import './Foo.js'` tombait sur ce .js périmé plutôt que
     * sur le .tsx — masquant silencieusement les modifications.
     */
    "noEmit": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist", "src-tauri", "balancing", "wireframes", "data"]
}
